# Model pipeline image (phase 2): build training set -> train -> validate -> sensitivity -> bias -> register.
# The same image runs locally and in GitHub Actions (.github/workflows/train.yml). The repo is mounted at
# /app, so the image holds only the pinned dependencies and the gcloud CLI (for the GCP registry backend):
#
#   docker build -f Dockerfile.train -t nsh-train .
#   docker run --rm -v "$PWD":/app nsh-train                          # dvc repro register, local registry
#   docker run --rm -v "$PWD":/app nsh-train pytest -q tests/registry # any other command
#
# Credentials are never baked in: Slack/SMTP via --env-file .env, GCP via a mounted gcloud config in CI.
FROM python:3.11-slim

ARG INSTALL_GCLOUD=true
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    MPLBACKEND=Agg

# git: DVC and the git_sha tag on every MLflow run; libgomp1: LightGBM; gcloud: GCP Artifact Registry
RUN apt-get update \
    && apt-get install -y --no-install-recommends git libgomp1 ca-certificates curl gnupg \
    && if [ "$INSTALL_GCLOUD" = "true" ]; then \
         curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
           | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
         && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
           > /etc/apt/sources.list.d/google-cloud-sdk.list \
         && apt-get update && apt-get install -y --no-install-recommends google-cloud-cli; \
       fi \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first (cached layer): the same pinned versions CI tests with.
COPY requirements.txt pyproject.toml ./
RUN pip install -r requirements.txt

# Editable install: /app/src is replaced by the mounted repo, so code changes need no rebuild.
COPY src ./src
RUN pip install --no-deps -e . && git config --system --add safe.directory '*'

CMD ["dvc", "repro", "register"]
