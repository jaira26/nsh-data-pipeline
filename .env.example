# Copy to .env (git-ignored) and fill in. Never commit real values.

# Linux: the output of `id -u`. Windows/macOS: leave 50000.
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# false = stats, anomalies and bias run one after another (the "before" Gantt run)
NSH_PARALLEL_REPORTS=true

# true = the dvc_version task also runs `dvc push` (needs remote credentials in the container)
DVC_PUSH=false

# M3 alerts (leave blank: the pipeline logs a warning and carries on)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Sender address; defaults to SMTP_USER
ALERT_EMAIL_FROM=
